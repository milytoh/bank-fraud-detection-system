<!DOCTYPE html>
<html lang="en">
    

<%- include('../partials/head', {
    title: "Customers - FraudShield",
    pageCss: "/css/customers.css"
}) %>

<body>

<%- include('../partials/sidebar') %>



<div class="main">

<%- include('../partials/topbar') %>
<%- include('../partials/flash') %>

<!-- PAGE CONTENT -->
<div class="page-header">
    <h1>Customers</h1>

    <a class="btn" href="/customers/create">
        + Add Customer
    </a>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            <% customers.forEach(c => { %>
                <tr>
                    <td><%= c.customer_code %></td>
                    <td><%= c.fullname %></td>
                    <td><%= c.email %></td>
                    <td><%= c.phone %></td>
                    <td>
                        <span class="status <%= c.status %>">
                            <%= c.status %>
                        </span>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

</div>

</body>
</html>