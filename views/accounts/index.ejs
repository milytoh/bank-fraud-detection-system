<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', {
    title: "Accounts - FraudShield",
    pageCss: "/css/accounts.css"
}) %>

<body>

<%- include('../partials/sidebar') %>

<div class="main">

    <%- include('../partials/topbar', { user }) %>

    <%- include('../partials/flash') %>

    <div class="page-header">

        <h1>Accounts</h1>

        <a href="/accounts/create" class="btn">
            + Open Account
        </a>

    </div>

    <div class="table-container">

        <% if (accounts.length === 0) { %>

            <div class="empty-state">
                <h3>No accounts found</h3>
                <p>Click "Open Account" to create your first account</p>
            </div>

        <% } else { %>

        <table>

            <thead>
                <tr>
                    <th>Account No</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th>Balance</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                <% accounts.forEach(account => { %>

                <tr>

                    <td>
                        <a class="acct-link" href="/accounts/<%= account.id %>">
                            <%= account.account_number %>
                        </a>
                    </td>

                    <td>
                        <%= account.fullname %>
                    </td>

                    <td>
                        <%= account.account_type %>
                    </td>

                    <td>
                        ₦<%= account.balance %>
                    </td>

                    <td>
                        <span class="status <%= account.status %>">
                            <%= account.status %>
                        </span>
                    </td>

                   <td>
                <div class="action-group">

                    <% if(account.status === 'active') { %>
                    <a href="/accounts/block/<%= account.id %>" class="btn btn-danger">
                        Block
                    </a>
                    <% } %>

                    <% if(account.status === 'blocked') { %>
                    <a href="/accounts/unblock/<%= account.id %>" class="btn btn-success">
                        Unblock
                    </a>
                    <% } %>

                </div>
                </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

        <% } %>

    </div>

    <%- include('../partials/footer') %>

</div>

<script src="/js/flash.js"></script>

</body>
</html>