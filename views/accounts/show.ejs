<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', {
    title: "Account Details - FraudShield",
    pageCss: "/css/accounts.css"
}) %>

<body>

<%- include('../partials/sidebar') %>

<div class="main">

<%- include('../partials/topbar', { user }) %>

<%- include('../partials/flash') %>

<div class="page-header">
    <h1>Account Details</h1>

    <a href="/accounts" class="btn">
        ← Back
    </a>
</div>

<div class="account-card">

    <div class="account-grid">

        <div>
            <h3>Account Number</h3>
            <p><%= account.account_number %></p>
        </div>

        <div>
            <h3>Customer Name</h3>
            <p><%= account.fullname %></p>
        </div>

        <div>
            <h3>Email</h3>
            <p><%= account.email %></p>
        </div>

        <div>
            <h3>Phone</h3>
            <p><%= account.phone %></p>
        </div>

        <div>
            <h3>Account Type</h3>
            <p><%= account.account_type %></p>
        </div>

        <div>
            <h3>Status</h3>
            <span class="status <%= account.status %>">
                <%= account.status %>
            </span>
        </div>

        <div>
            <h3>Balance</h3>
            <p>₦<%= account.balance %></p>
        </div>

        <div>
            <h3>Created</h3>
            <p><%= account.created_at.toDateString() %></p>
        </div>

        <div class="actions">

   <div class="action-buttons">

    <a href="/transactions/create?type=deposit&account=<%= account.id %>" class="btn">
        Deposit
    </a>

    <a href="/transactions/create?type=withdraw&account=<%= account.id %>" class="btn">
        Withdraw
    </a>

    <a href="/transactions/create?type=transfer&account=<%= account.id %>" class="btn">
        Transfer
    </a>

</div>

</div>

    </div>

</div>



</div>



</body>
</html>