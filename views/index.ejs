<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png">
<link rel="icon" type="image/png" sizes="16x16" href="/img/logo.png">
    <title>FraudShield – Secure Banking Powered by AI</title>

    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <!-- ===== NAVIGATION ===== -->
    <nav class="nav" id="nav">
      <div class="nav__inner">
        <a class="nav__brand" href="/">
          <img class="f-logo" src="/img/logo.png" alt="FraudShield Logo" />
        </a>

        <button
          class="nav__toggle"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="navMenu"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <div class="nav__menu" id="navMenu">
          <div class="nav__links">
            <a href="#" class="active">Personal</a>
            <a href="#">Wealth</a>
            <a href="#">Security</a>
            <a href="#">Support</a>
          </div>

        <div class="nav__actions">

     <% if (customerIsAuthenticated) { %>

        <a class="btn-ghost" href="/accounts/user/dashboard">
            My Dashboard
        </a>

        <a class="btn-primary" href="/auth/logout">
            Logout
        </a>
 
     <% } else if (adminIsAuthenticated) { %>

        <a class="btn-ghost" href="/dashboard">
            Admin Dashboard
        </a>

        <a class="btn-primary" href="/auth/logout">
            Logout
        </a>

     <% } else { %>

        <a class="btn-ghost" href="/auth/customer-login">
            Login
        </a>

        <a class="btn-primary" href="/auth/login">
            Admin Login
        </a>

     <% } %>

      </div>
        </div>
      </div>
    </nav>

    <!-- ===== MAIN ===== -->
    <main>
      <!-- HERO -->
      <section class="hero reveal" id="hero">
        <div class="hero__grid">
          <!-- Left: Copy -->
          <div class="hero__content">
            <div class="hero__badge">
              <span class="material-symbols-outlined">verified_user</span>
              Next-Gen Digital Security
            </div>

            <h1 class="hero__headline">
              Secure Banking Powered by<br />
              <span>Fraud Detection</span>
            </h1>

            <p class="hero__subtext">
              Protecting customer transactions through intelligent fraud
              monitoring, real-time alerts, and secure digital banking.
              Experience institutional stability merged with cutting-edge tech.
            </p>

            <div class="hero__actions">
              <a href="/auth/customer-login" class="btn-hero-primary"
                >Customer Login</a
              >
              <a href="/auth/login" class="btn-hero-secondary">Admin Login</a>
            </div>
          </div>

          <!-- Right: Visual -->
          <div class="hero__visual">
            <div class="hero__glow"></div>
            <div class="glass hero__frame">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDeRrmN-lA300irNzpBnbXbfXwaUTv-3x5QiJXmvMPNFJyv2Nb5LMQLAG6H5pu5nPCNU9WPCuwH0PjB8yO5FaRsp15J6K3Lofv0DelQsJ8D2pBwKUvR1lSNxlSelgwa3CF1GPDf9dpRSbATlvG0H28cIAxuciGPVYOGihfm2bzgBSj-sCuLYQHcfDwbMjHgHBUvou1UPjO7X6tCLAI9Nho_6bYtHOUt5tM7olja4c8mEvxt-kPGkrXn8bQ-dKsuDw-Hoqva8K_dLr08"
                alt="AI-powered fraud detection dashboard on a high-end laptop"
              />
              <div class="hero__status-chip">
                <div class="hero__status-row">
                  <span class="pulse-dot"></span>
                  <span class="hero__status-label">System Online</span>
                </div>
                <p class="hero__status-value">Active Scans: 1.4M</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- FEATURES -->
      <section class="features reveal">
        <div class="section-header">
          <h2 class="section-title">Uncompromising Security Features</h2>
          <p class="section-subtitle">
            Built on layers of invisible protection
          </p>
        </div>

        <div class="features__grid">
          <div class="glass-card feature-card">
            <div class="feature-card__icon">
              <span class="material-symbols-outlined">security</span>
            </div>
            <h3 class="feature-card__title">Fraud Detection</h3>
            <p class="feature-card__body">
              Advanced ML algorithms scanning every transaction for suspicious
              patterns 24/7.
            </p>
          </div>

          <div class="glass-card feature-card">
            <div class="feature-card__icon">
              <span class="material-symbols-outlined">account_balance</span>
            </div>
            <h3 class="feature-card__title">Secure Transactions</h3>
            <p class="feature-card__body">
              End-to-end encryption using military-grade standards for all
              financial operations.
            </p>
          </div>

          <div class="glass-card feature-card">
            <div class="feature-card__icon">
              <span class="material-symbols-outlined">monitoring</span>
            </div>
            <h3 class="feature-card__title">Real-Time Monitoring</h3>
            <p class="feature-card__body">
              Live dashboard for instant visibility into account activity across
              the globe.
            </p>
          </div>

          <div class="glass-card feature-card">
            <div class="feature-card__icon">
              <span class="material-symbols-outlined">verified</span>
            </div>
            <h3 class="feature-card__title">Account Protection</h3>
            <p class="feature-card__body">
              Multi-layer authentication and biometric locks for total digital
              asset control.
            </p>
          </div>
        </div>
      </section>

      <!-- SYSTEM OVERVIEW -->
      <section class="overview reveal">
        <div class="overview__inner">
          <div class="overview__image-wrap">
            <img
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBwO6-8p56gw9FvEIYt_fpkx2tT-2wcusw1BPvPMPy9b1fNMEFriN1WMbbGp7Cv8Te-PR2AlKbHwxEjz2c38tv2XPQpWqVD5R7ajv7PpQIEERBCF64xecbgDVeleMusp4CWsMfKhTBCcNh9W6XSqQKWvkJ5gnTccVH5mz-U4ZZKMhZ7c7n1Sf4cAIXaCQIHpL1SVdmWak0bT6x_KnUeBe7quf5g4DJrWNsoGO4bHEmCbiKBEI5fE6cHuEMkfNgqliQHaSM_wZaom4fX"
              alt="FraudShield analytics dashboard showing fraud alerts and financial data"
            />
          </div>

          <div class="overview__content">
            <h2 class="overview__headline">
              The Intelligence<br />
              <span>Behind the Shield</span>
            </h2>

            <p class="overview__body">
              Our system doesn't just react—it predicts. By analyzing billions
              of data points, FraudShield Bank creates a custom security profile
              for every user, identifying anomalies before they become threats.
            </p>

            <ul class="overview__list">
              <li>
                <span class="material-symbols-outlined">check_circle</span>
                Adaptive Risk Scoring
              </li>
              <li>
                <span class="material-symbols-outlined">check_circle</span>
                Geographic Login Verification
              </li>
              <li>
                <span class="material-symbols-outlined">check_circle</span>
                Behavioral Biometrics Analysis
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- HOW IT WORKS -->
      <section class="how-it-works reveal">
        <h2 class="hiw__headline">How It Works</h2>

        <div class="hiw__steps-wrap">
          <div class="hiw__connector" aria-hidden="true"></div>

          <div class="hiw__steps">
            <div class="hiw__step">
              <div class="hiw__step-number">1</div>
              <h4 class="hiw__step-title">Transaction</h4>
              <p class="hiw__step-desc">
                Customer initiates a digital payment or transfer.
              </p>
            </div>
            <div class="hiw__step">
              <div class="hiw__step-number">2</div>
              <h4 class="hiw__step-title">Analysis</h4>
              <p class="hiw__step-desc">
                AI engine cross-references 100+ risk variables in milliseconds.
              </p>
            </div>
            <div class="hiw__step">
              <div class="hiw__step-number">3</div>
              <h4 class="hiw__step-title">Flagging</h4>
              <p class="hiw__step-desc">
                Suspicious activity is instantly isolated for verification.
              </p>
            </div>
            <div class="hiw__step">
              <div class="hiw__step-number">4</div>
              <h4 class="hiw__step-title">Resolution</h4>
              <p class="hiw__step-desc">
                Secure approval via app or instant fraud prevention.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- STATS -->
      <section class="stats reveal">
        <div class="glass-card stat-card">
          <p class="stat-card__number">99.9%</p>
          <p class="stat-card__label">Secure Transactions</p>
        </div>
        <div class="glass-card stat-card">
          <p class="stat-card__number">24/7</p>
          <p class="stat-card__label">Real-Time Monitoring</p>
        </div>
        <div class="glass-card stat-card">
          <p class="stat-card__number">&lt; 1s</p>
          <p class="stat-card__label">Instant Fraud Alerts</p>
        </div>
        <div class="glass-card stat-card">
          <p class="stat-card__number">5M+</p>
          <p class="stat-card__label">Protected Accounts</p>
        </div>
      </section>

      <!-- PORTALS -->
      <section class="portals reveal">
        <div class="portals__grid">
          <!-- Customer Portal -->
          <div class="portal portal--customer">
            <div class="portal__icon portal__icon--primary">
              <span class="material-symbols-outlined">person</span>
            </div>
            <h2 class="portal__title">Customer Portal</h2>
            <p class="portal__desc">
              Access your accounts, manage assets, and view security alerts from
              anywhere in the world.
            </p>
            <ul class="portal__features">
              <li>
                <span class="portal__dot portal__dot--primary"></span> Secure
                Biometric Login
              </li>
              <li>
                <span class="portal__dot portal__dot--primary"></span> Global
                Card Control
              </li>
              <li>
                <span class="portal__dot portal__dot--primary"></span> Wealth
                Management Tools
              </li>
            </ul>
            <a href="/auth/customer-login" class="btn-portal-primary"
              >Launch Personal Portal</a
            >
          </div>

          <!-- Admin Hub -->
          <div class="portal portal--admin">
            <div class="portal__icon portal__icon--error">
              <span class="material-symbols-outlined"
                >admin_panel_settings</span
              >
            </div>
            <h2 class="portal__title">Admin Hub</h2>
            <p class="portal__desc">
              High-level system oversight, fraud pattern analysis, and
              institutional security controls.
            </p>
            <ul class="portal__features">
              <li>
                <span class="portal__dot portal__dot--error"></span> Threat
                Intel Dashboard
              </li>
              <li>
                <span class="portal__dot portal__dot--error"></span> Global
                Transaction Review
              </li>
              <li>
                <span class="portal__dot portal__dot--error"></span> Policy
                Enforcement AI
              </li>
            </ul>
            <a href="/auth/login" class="btn-portal-error"
              >Access Admin Terminal</a
            >
          </div>
        </div>
      </section>

      <!-- TESTIMONIALS -->
      <section class="testimonials reveal">
        <h2 class="testimonials__headline">Trusted by Leaders</h2>

        <div class="testimonials__grid">
          <div class="glass-card testimonial-card">
            <div class="stars">
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
            </div>
            <p class="testimonial-card__quote">
              "The level of detail in the security monitoring is unparalleled. I
              feel completely secure knowing FraudShield is watching my assets."
            </p>
            <div class="testimonial-card__author">
              <div class="author-avatar">
                <span class="material-symbols-outlined">person</span>
              </div>
              <div>
                <p class="author-name">Jonathan Vance</p>
                <p class="author-role">CEO, Vance Capital</p>
              </div>
            </div>
          </div>

          <div class="glass-card testimonial-card">
            <div class="stars">
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
            </div>
            <p class="testimonial-card__quote">
              "FraudShield detected a spoofed transaction in real-time that
              other banks missed. Their technology is truly next-generation."
            </p>
            <div class="testimonial-card__author">
              <div class="author-avatar">
                <span class="material-symbols-outlined">person</span>
              </div>
              <div>
                <p class="author-name">Dr. Elena Rodriguez</p>
                <p class="author-role">CTO, SecureLink</p>
              </div>
            </div>
          </div>

          <div class="glass-card testimonial-card">
            <div class="stars">
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
              <span class="material-symbols-outlined">star</span>
            </div>
            <p class="testimonial-card__quote">
              "The interface is beautiful, but the peace of mind is what keeps
              me here. It's the standard for premium banking security."
            </p>
            <div class="testimonial-card__author">
              <div class="author-avatar">
                <span class="material-symbols-outlined">person</span>
              </div>
              <div>
                <p class="author-name">Marcus Thorne</p>
                <p class="author-role">Wealth Advisor</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer>
      <div class="footer__grid">
        <div class="footer__brand">
          <div class="footer__logo">
            <span class="footer__logo-text">FraudShield</span>
          </div>
          <p class="footer__brand-desc">
            Institutional-grade security for the modern era. Protecting what
            matters most with invisible intelligence.
          </p>
        </div>

        <div class="footer__col">
          <h4>Solutions</h4>
          <nav class="footer__nav">
            <a href="#">Personal Banking</a>
            <a href="#">Wealth Management</a>
            <a href="#">Corporate Security</a>
            <a href="#">Fraud Hub</a>
          </nav>
        </div>

        <div class="footer__col">
          <h4>Resources</h4>
          <nav class="footer__nav">
            <a href="#">Security Guarantee</a>
            <a href="#">Support Center</a>
            <a href="#">API Documentation</a>
            <a href="#">Compliance</a>
          </nav>
        </div>

        <div class="footer__col">
          <h4>Newsletter</h4>
          <p class="footer__newsletter-desc">
            Get monthly security insights and banking updates.
          </p>
          <div class="footer__email-row">
            <input
              class="footer__email-input"
              type="email"
              placeholder="Email address"
              aria-label="Email address for newsletter"
            />
            <button class="footer__email-btn">Join</button>
          </div>
        </div>
      </div>

      <div class="footer__bottom">
        <div class="footer__bottom-inner">
          <p class="footer__copy">
            © 2024 FraudShield Bank. Member FDIC. Equal Housing Lender.
          </p>
          <div class="footer__legal">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Service</a>
            <a href="#">Cookie Settings</a>
            <a href="#">Accessibility</a>
          </div>
        </div>
      </div>
    </footer>

    <script src="/js/main.js"></script>
  </body>
</html>
